<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Header Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/primary"
        android:paddingHorizontal="8dp"
        android:paddingVertical="12dp"
        android:elevation="4dp">

        <ImageButton
            android:id="@+id/ibBackReminders"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="@string/back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="6dp"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Task Reminders"
                android:textColor="@color/text_white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Upcoming deadlines and urgent assignments"
                android:textColor="@color/text_white_translucent"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Urgency Filter Chips Bar -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:background="@color/surface">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All (0)"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_chip_selected"
                android:textColor="@color/text_on_primary"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chipOverdue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️ Overdue (0)"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_chip_unselected"
                android:textColor="@color/text_secondary"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chipTomorrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏳ Due Tomorrow (0)"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_chip_unselected"
                android:textColor="@color/text_secondary"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chipUpcoming"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📅 Upcoming (0)"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_chip_unselected"
                android:textColor="@color/text_secondary"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- Content Area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvReminders"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="16dp"
            tools:listitem="@layout/item_reminder" />

        <!-- Loading Indicator -->
        <ProgressBar
            android:id="@+id/pbLoadingReminders"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/primary"
            android:visibility="gone" />

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/layoutEmptyReminders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_calendar"
                android:alpha="0.35"
                app:tint="@color/primary"
                android:contentDescription="@null"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tvEmptyTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No Reminders Found"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvEmptySubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="You do not have any pending tasks matching this filter."
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:gravity="center"
                android:lineSpacingExtra="2dp" />

        </LinearLayout>

        <!-- Legacy View stubs for compile safety -->
        <TextView
            android:id="@+id/tvReminder1"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvReminder2"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvReminder3"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>