<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardReminder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="14dp"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp"
    app:rippleColor="#1A1E3A8A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Top Header: Status Badges, Overdue Tag, and Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <!-- Completed Checkbox / Toggle -->
            <CheckBox
                android:id="@+id/cbReminderCompleted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/primary"
                android:layout_marginEnd="6dp" />

            <!-- Status Badge -->
            <TextView
                android:id="@+id/tvReminderStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:background="@drawable/bg_stat_inprogress"
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="PENDING" />

            <!-- Overdue Badge (if past scheduled time) -->
            <TextView
                android:id="@+id/tvCountdownBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:background="@drawable/bg_priority_high"
                android:textColor="@color/priority_high_text"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="⚠️ OVERDUE" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Edit Button -->
            <ImageButton
                android:id="@+id/btnEditReminder"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_edit"
                app:tint="@color/text_secondary"
                android:contentDescription="Edit Reminder"
                android:layout_marginEnd="4dp" />

            <!-- Delete Button -->
            <ImageButton
                android:id="@+id/btnDeleteReminder"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_delete"
                app:tint="#DC2626"
                android:contentDescription="Delete Reminder" />

        </LinearLayout>

        <!-- Reminder Title -->
        <TextView
            android:id="@+id/tvReminderTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginBottom="4dp"
            tools:text="Prepare Midterm Question Paper" />

        <!-- Description Snippet -->
        <TextView
            android:id="@+id/tvReminderDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:maxLines="3"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:layout_marginBottom="10dp"
            tools:text="Include 5 objective questions and 3 problem solving questions from Unit 3." />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginBottom="10dp" />

        <!-- Bottom Row: Scheduled Time Pill & Alarm Icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_calendar"
                android:layout_marginEnd="6dp"
                app:tint="@color/primary"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tvReminderDeadline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="⏰ Scheduled: Tomorrow at 10:00 AM" />

            <TextView
                android:id="@+id/tvReminderPriority"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <View
                android:id="@+id/btnDiscussReminder"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
