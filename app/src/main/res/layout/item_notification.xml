<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardNotification"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="14dp"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp"
    app:rippleColor="#1A1E3A8A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Row: Type Pill, Priority, Unread Dot, Timestamp -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <!-- Type badge -->
            <TextView
                android:id="@+id/tvNotificationType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:background="@drawable/bg_stat_total"
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="📢 NEW TASK" />

            <!-- Priority -->
            <TextView
                android:id="@+id/tvNotificationPriority"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:background="@drawable/bg_priority_high"
                android:textColor="@color/priority_high_text"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginStart="6dp"
                tools:text="HIGH" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Unread Indicator Dot -->
            <View
                android:id="@+id/viewUnreadDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/button_ellipse"
                android:backgroundTint="@color/primary_light" />

            <!-- Timestamp -->
            <TextView
                android:id="@+id/tvNotificationTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                tools:text="Today, 10:45 AM" />

        </LinearLayout>

        <!-- Subtitle / Subject (bold task name or announcement title) -->
        <TextView
            android:id="@+id/tvNotificationSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"
            tools:text="Result Analysis &amp; Department Performance" />

        <!-- Notification Message / Description snippet -->
        <TextView
            android:id="@+id/tvNotificationMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:layout_marginBottom="8dp"
            tools:text="Please prepare semester pass percentage metrics and subject-wise failure reports for tomorrow's meeting." />

        <!-- Deadline row if applicable -->
        <TextView
            android:id="@+id/tvNotificationDeadline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:drawableStart="@drawable/ic_calendar"
            android:drawablePadding="6dp"
            android:drawableTint="@color/text_secondary"
            android:layout_marginBottom="10dp"
            tools:text="Due: 28 Sep 2026" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginBottom="10dp" />

        <!-- Interactive Action Buttons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMarkRead"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Mark Read"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:paddingHorizontal="8dp"
                android:layout_marginEnd="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDismiss"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Dismiss"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:paddingHorizontal="8dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPrimaryAction"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Open Chat"
                android:textColor="@color/text_white"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:paddingHorizontal="14dp"
                app:cornerRadius="18dp"
                app:backgroundTint="@color/primary"
                tools:text="Open Chat" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
